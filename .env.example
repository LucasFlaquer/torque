# Copy to .env and adjust. Docker Compose also reads .env from the repository root.

# PostgreSQL (docker-compose.yml and packages/db)
POSTGRES_USER=torque
POSTGRES_PASSWORD=torque
POSTGRES_DB=torque
POSTGRES_PORT=5432
DATABASE_URL=postgresql://torque:torque@localhost:5432/torque?schema=public

# Redis (docker-compose.yml and packages/redis)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Better Auth session signing secret. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL that the web app's Server Components and Server Actions use to reach the API
API_INTERNAL_URL=http://localhost:3333

# Web app origin that the API trusts
WEB_ORIGIN=http://localhost:3000
