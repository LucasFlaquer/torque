  },
  "devDependencies": {
    "@torque/lint-config": "workspace:*",
    "@torque/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.92.0",
    "typescript": "7.0.2"
  }
}
