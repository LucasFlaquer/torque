# Copy to apps/api/.env and adjust. Validated in src/env.ts.
# NODE_ENV is not listed on purpose: the API defaults to "development", and Vitest sets "test".

API_HOST=0.0.0.0
API_PORT=3333
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Must match POSTGRES_* and REDIS_PORT in the root .env (Docker Compose)
DATABASE_URL=postgresql://torque:torque@localhost:5432/torque?schema=public
REDIS_URL=redis://localhost:6379

# Web app origin that the API trusts
WEB_ORIGIN=http://localhost:3000

# Better Auth session signing secret. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
